# Copy to .env and edit:  cp .env.example .env
# Then:  docker compose up -d          # pulls the image from Docker Hub
#
# See docs/deployment.md for the full walkthrough.

# ---------------------------------------------------------------------------
# REQUIRED — master encryption key for stored secrets (OIDC client secret,
# signing-key passwords). Generate once and never change it:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
FDROID_MASTER_KEY=

# ---------------------------------------------------------------------------
# Public identity
# ---------------------------------------------------------------------------
# Canonical repo URL shown to F-Droid clients.
FDROID_REPO_URL=http://localhost:8082/fdroid/repo
# Repo name shown in the F-Droid client.
FDROID_REPO_NAME=My F-Droid Repository
# Public base URL when the app sits behind a TLS reverse proxy, e.g.
# https://apps.example.com  (used to build the OIDC redirect_uri and repo URL).
FDROID_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Host directories (the /data and /config mounts always use ./data and ./config)
# ---------------------------------------------------------------------------
# Root of the fdroid repository (config.yml + keystore.p12 + metadata/ + repo/).
#   existing repo  -> point this at its root (adopts it in place, same key)
#   fresh install  -> leave the default empty dir, then run
#                     "Initialize repository" from the Web UI
FDROID_REPO_HOST=./fdroidrepo

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Docker Hub image to pull (override via FDROID_IMAGE if you host it elsewhere).
FDROID_IMAGE=docker.io/npodbielski/fdroidmgr:latest

# Host port the manager is published on (the container always listens on 8080).
FDROID_PORT=8082

# Require an API key / session to download repo files (index + APKs).
# Default true: F-Droid clients add the repo as https://user:apikey@host/fdroid/repo
# (the keyed URL is shown in the UI next to the client key). Set false to serve
# the repository anonymously to anyone who has the URL.
FDROID_REQUIRE_REPO_AUTH=true

# Directory (inside the container, on the /data mount) that /fdroid/repo/**
# serves: a staged mirror of the output dir, so the working tree is never
# reachable over HTTP. Set it empty to serve the output dir directly.
# FDROID_REPO_PUBLIC_PATH=/data/fdroidrepo/public
